<config>

  <ImportLibrary library="gmGraphics"/>
  <ImportLibrary library="gmTrack"/>

  <SdlWindow
      size="1920 1080"
      title="Hmd View of Cube Set"
      GLMajor="3" GLMinor="3">

    <SdlContext
        DEF="SDLContext"
        useVideo="1"/>

    <TiledView>

      <param name="tileLocation" value="0 0 1 1"/>
      <HmdView DEF="HMD" showEye="0">
        <OpenVR
            DEF="OPENVR"
            useVideo="true"
            manifestPath="urn:gramods:config/openvr_manifest/standard_actionset.json"
            actionSet="/actions/std"/>

        <TrackedTransform>
          <OpenVRPoseTracker type="TrackingReference">
            <OpenVR USE="OPENVR"/>
          </OpenVRPoseTracker>

		      <RelativePoseTracker
	            originKey="/in/pose/serial/LHR-03D3A5F2">
            <OffsetPoseTracker
                positionOffset="0 0 0.1">
              <OpenVRPoseTracker serial="LHR-06CD3CBB">
                <OpenVR USE="OPENVR"/>
              </OpenVRPoseTracker>
            </OffsetPoseTracker>
            <OpenVRPoseTracker serial="LHR-03D3A5F2">
              <OpenVR USE="OPENVR"/>
            </OpenVRPoseTracker>
          </RelativePoseTracker>

          <OpenVRPoseTracker serial="LHR-03D3A5F2">
            <OpenVR USE="OPENVR"/>
          </OpenVRPoseTracker>

          <OffsetPoseTracker
              positionOffset="0 0 0.1">
            <OpenVRPoseTracker serial="LHR-06CD3CBB">
              <OpenVR USE="OPENVR"/>
            </OpenVRPoseTracker>
          </OffsetPoseTracker>

          <PoseTransform scale="0.1 0.1 0.1">
            <ObjRenderer file="urn:gramods:gmGraphics/resources/axes.obj"/>
		      </PoseTransform>
        </TrackedTransform>

        <ObjRenderer file="urn:gramods:gmGraphics/resources/floor-coordinates.obj"/>

      </HmdView>

      <param name="tileLocation" value="0 1 1 1"/>
      <PosedSphericalView>
        <EquirectangularCoordinatesMapper/>

        <TrackedTransform>
          <OpenVRPoseTracker type="HMD">
            <OpenVR USE="OPENVR"/>
          </OpenVRPoseTracker>

          <SphereRenderer>
            <RectilinearCameraModel focalDistance="0.6 1.0"/>
            <ViewTexture>
              <View USE="HMD"/>
            </ViewTexture>
          </SphereRenderer>
        </TrackedTransform>
      </PosedSphericalView>

    </TiledView>

  </SdlWindow>

</config>
