<config>

  <ImportLibrary library="gmGraphics"/>
  <ImportLibrary library="gmTrack"/>

  <SdlWindow
      size="1920 1080"
      title="Hmd View of Cube Set"
      GLMajor="3" GLMinor="3">

    <SdlContext
        DEF="SDLContext"
        useVideo="1"/>

    <HmdView DEF="HMD" showEye="0">
      <OpenVR
          DEF="OPENVR"
          useVideo="true"
          manifestPath="urn:gramods:config/openvr_manifest/standard_actionset.json"
          actionSet="/actions/std"/>

      <TrackedTransform DEF="TT">

        <!-- All Non-HMD Trackers -->
        <OpenVRPoseTracker type="TrackingReference">
          <OpenVR USE="OPENVR"/>
        </OpenVRPoseTracker>
        <OpenVRPoseTracker type="GenericTracker">
          <OpenVR USE="OPENVR"/>
        </OpenVRPoseTracker>
        <OpenVRPoseTracker type="Controller">
          <OpenVR USE="OPENVR"/>
        </OpenVRPoseTracker>

        <OffsetPoseTracker
            DEF="PIKE"
            positionOffset="0 0 0.1">
          <OpenVRPoseTracker serial="LHR-06CD3CBB">
            <OpenVR USE="OPENVR"/>
          </OpenVRPoseTracker>
        </OffsetPoseTracker>

        <!-- Pike Relative to Helmet Tracker -->
        <RelativePoseTracker
            originKey="/in/pose/serial/LHR-03D3A5F2">
          <OffsetPoseTracker USE="PIKE"/>
          <OpenVRPoseTracker serial="LHR-03D3A5F2">
            <OpenVR USE="OPENVR"/>
          </OpenVRPoseTracker>
        </RelativePoseTracker>

        <PoseTransform scale="0.1 0.1 0.1">
          <ObjRenderer file="urn:gramods:gmGraphics/resources/axes.obj"/>
        </PoseTransform>
      </TrackedTransform>

      <ObjRenderer file="urn:gramods:gmGraphics/resources/floor-coordinates.obj"/>

    </HmdView>

  </SdlWindow>

</config>
